# /etc/ai-dashboard/ai-dashboard.env  (chmod 600)
# Public https address Caddy serves; include the port if it is not 443.
DASHBOARD_PUBLIC_URL=https://1-2-3-4.sslip.io:8443
# Local port Caddy forwards to.
DASHBOARD_PORT=8787
# The coding agent's own env file: the dashboard reads its bot token,
# YOUR_CHAT_ID and AGENT_SNAPSHOT_FILE from there instead of copying them.
CODING_ENV_FILE=/etc/ai-coding-agent/ai-coding-agent.env
# systemd unit whose state the Coding window reports.
CODING_SERVICE=ai-coding-agent

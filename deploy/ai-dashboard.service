[Unit]
Description=Telegram Mini App dashboard for the AI agents
After=network-online.target
Wants=network-online.target
# A config error exits with status 2; stop retrying after repeated failures.
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=/opt/ai-dashboard
EnvironmentFile=/etc/ai-dashboard/ai-dashboard.env
ExecStart=/opt/ai_dashboard_venv/bin/python -m ai_dashboard
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
